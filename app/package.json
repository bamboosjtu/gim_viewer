{
  "name": "gim-powerline-app",
  "version": "0.1.6",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1421",
    "build": "node ../desktop/scripts/with-workspace-temp.mjs node_modules/typescript/bin/tsc --noEmit && node ../desktop/scripts/with-workspace-temp.mjs node_modules/vite/bin/vite.js build",
    "test": "node ../desktop/scripts/with-workspace-temp.mjs node_modules/vitest/vitest.mjs run",
    "test:module": "node ../desktop/scripts/with-workspace-temp.mjs ../desktop/scripts/test-module.mjs",
    "test:sample": "node ../desktop/scripts/with-workspace-temp.mjs node_modules/vitest/vitest.mjs run --config vitest.samples.config.ts",
    "tauri": "tauri",
    "android:init": "tauri android init",
    "android:dev": "tauri android dev",
    "android:build": "tauri android build --target aarch64 --apk",
    "prebuild": "node ../contracts/generate-native.mjs --check",
    "check:native-contracts": "node ../contracts/generate-native.mjs --check"
  },
  "dependencies": {
    "@gim/plugin-api": "file:../packages/plugin-api",
    "@gim/powerline-core": "file:../packages/powerline-core",
    "@tauri-apps/api": "^2.10.1",
    "maplibre-gl": "^5.24.0",
    "@gim/contracts-native": "file:../packages/contracts-native",
    "@gim/gim-primitives": "file:../packages/gim-primitives"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.3",
    "@types/node": "^22.0.0",
    "typescript": "5.9.3",
    "vite": "^5.4.21",
    "vitest": "2.0.0"
  }
}
