# ---- 打包产物（onedir，可用 README §6 的命令重建）----
dist/
build/
_build/*
# 打包配置本身要入库，其余 _build 内容（分析缓存、warn 文件、冒烟截图）不入库
!_build/GIM实体盘点器.spec

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- 临时文件与冒烟截图 ----
smoke*.png
*.tmp
_tmp/

# ---- 本地盘点导出（默认导出到上次目录，落在库里时忽略）----
导出_*.csv
导出_*.json

# ---- IDE ----
.vscode/
.idea/
*.swp
*.swo
*~

# ---- OS ----
.DS_Store
Thumbs.db
desktop.ini

# ---- 日志 ----
*.log
