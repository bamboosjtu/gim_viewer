# Windows working copies use CRLF; Git stores normalized text.
* text=auto eol=crlf

# Tauri rewrites Cargo.toml as LF. The Android wrapper runs as a POSIX script.
/desktop/src-tauri/Cargo.toml text eol=lf
/app/src-tauri/gen/android/gradlew text eol=lf

# Retain space/tab checks for existing CRLF blobs in the repository.
/desktop/src/gim/substationEvidence.ts whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
/desktop/src/gim/__tests__/substationEvidence.test.ts whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
/desktop/src/services/__tests__/selectionInteraction.test.ts whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
