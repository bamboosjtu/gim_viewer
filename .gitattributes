# Windows working copies use CRLF; Git stores normalized text.
* text=auto eol=crlf

# Tauri rewrites Cargo.toml as LF. The Android wrapper runs as a POSIX script.
/desktop/src-tauri/Cargo.toml text eol=lf
/app/src-tauri/gen/android/gradlew text eol=lf

# Retain space/tab checks for existing CRLF blobs in the repository.
/desktop/src/gim/substationEvidence.ts whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
/desktop/src/gim/__tests__/substationEvidence.test.ts whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
/desktop/src/services/__tests__/selectionInteraction.test.ts whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# Tauri regenerates these tracked schemas and permission files with LF.
/app/src-tauri/gen/schemas/desktop-schema.json text eol=lf
/app/src-tauri/gen/schemas/windows-schema.json text eol=lf
/crates/tauri-plugin-gim-import/permissions/autogenerated/commands/cancel.toml text eol=lf
/crates/tauri-plugin-gim-import/permissions/autogenerated/commands/check_location_permissions.toml text eol=lf
/crates/tauri-plugin-gim-import/permissions/autogenerated/commands/get_position.toml text eol=lf
/crates/tauri-plugin-gim-import/permissions/autogenerated/commands/get_window_state.toml text eol=lf
/crates/tauri-plugin-gim-import/permissions/autogenerated/commands/pick.toml text eol=lf
/crates/tauri-plugin-gim-import/permissions/autogenerated/commands/request_location_permissions.toml text eol=lf
/crates/tauri-plugin-gim-import/permissions/autogenerated/commands/set_immersive.toml text eol=lf
/crates/tauri-plugin-gim-import/permissions/autogenerated/reference.md text eol=lf
/crates/tauri-plugin-gim-import/permissions/schemas/schema.json text eol=lf
