{
  "name": "gim-reader",
  "version": "0.2.0",
  "description": "GIM 浏览器",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-web-ifc-wasm.mjs",
    "dev": "vite",
    "check:version": "node scripts/check-desktop-version.mjs",
    "check:engineering-boundaries": "node scripts/check-engineering-boundaries.mjs",
    "check:engineering-catalog": "node scripts/check-engineering-catalog.mjs",
    "check:engineering-docs": "node scripts/check-engineering-docs.mjs",
    "test:version": "node scripts/with-workspace-temp.mjs --test scripts/check-desktop-version.test.mjs",
    "prebuild": "node scripts/check-desktop-version.mjs && node scripts/copy-web-ifc-wasm.mjs",
    "build": "node scripts/with-workspace-temp.mjs node_modules/typescript/bin/tsc && node scripts/with-workspace-temp.mjs node_modules/vite/bin/vite.js build",
    "preview": "vite preview",
    "pretauri:dev": "node scripts/check-desktop-version.mjs && node scripts/copy-web-ifc-wasm.mjs",
    "tauri:dev": "node scripts/tauri-wrapper.mjs dev",
    "webview2:prepare": "node scripts/prepare-webview2-fixed-runtime.mjs",
    "pretauri:build": "node scripts/check-desktop-version.mjs && node scripts/copy-web-ifc-wasm.mjs && node scripts/prepare-webview2-fixed-runtime.mjs",
    "tauri:build": "node scripts/tauri-wrapper.mjs build",
    "posttauri:build": "node scripts/package-portable.mjs",
    "test": "node scripts/with-workspace-temp.mjs node_modules/vitest/vitest.mjs run",
    "test:sqlite": "node scripts/with-workspace-temp.mjs node_modules/vitest/vitest.mjs run --config vitest.sqlite.config.ts",
    "test:sample": "node scripts/with-workspace-temp.mjs node_modules/vitest/vitest.mjs run --config vitest.sample.config.ts",
    "engineering:baseline": "python scripts/engineering/prepare-baseline.py",
    "engineering:geometry-input": "python scripts/engineering/prepare-geometry-input.py",
    "test:engineering:nine": "node scripts/with-workspace-temp.mjs scripts/engineering/run-nine.mjs",
    "engineering:prepare-corpus": "python scripts/engineering/prepare-corpus.py",
    "engineering:prepare-geometry": "python scripts/engineering/prepare-corpus.py --geometry",
    "test:engineering:geometry": "node scripts/with-workspace-temp.mjs scripts/engineering/run-geometry.mjs",
    "engineering:golden-candidates": "node scripts/engineering/run-nine.mjs --candidates",
    "test:engineering:worker": "node scripts/with-workspace-temp.mjs scripts/engineering/check-worker-browser.mjs",
    "test:web-performance": "node scripts/with-workspace-temp.mjs scripts/engineering/web-perf-browser.mjs",
    "test:engineering:separation": "node scripts/with-workspace-temp.mjs node_modules/vitest/vitest.mjs run --config vitest.separation.config.ts",
    "test:engineering:classification": "node scripts/with-workspace-temp.mjs scripts/engineering/check-classification-samples.mjs",
    "test:substation:strict": "node scripts/with-workspace-temp.mjs scripts/test-substation-strict.mjs",
    "test:all": "npm run test:sample && npm test && npm run test:sqlite",
    "test:watch": "vitest",
    "acceptance:build": "node scripts/benchmarks/acceptance-build.mjs",
    "acceptance:stage": "node scripts/benchmarks/acceptance-stage.mjs",
    "test:acceptance-tools": "node scripts/with-workspace-temp.mjs --test scripts/benchmarks/acceptance-build.test.mjs scripts/benchmarks/acceptance-probe.test.mjs",
    "test:coverage": "node scripts/with-workspace-temp.mjs node_modules/vitest/vitest.mjs run --coverage",
    "test:ifc-critical": "node scripts/with-workspace-temp.mjs node_modules/vitest/vitest.mjs run src/viewer/__tests__/ifcConversion.test.ts src/viewer/__tests__/ifcSessionRace.test.ts src/viewer/__tests__/ifcFragmentsCache.test.ts src/viewer/__tests__/ifcNameIndex.test.ts src/viewer/__tests__/ifcOpeningPolicy.test.ts src/viewer/__tests__/ifcRegionalData.test.ts src/viewer/__tests__/ifcBimLoader.test.ts src/viewer/__tests__/webIfcCompatibility.test.ts src/ui/__tests__/ifcDetailModeControl.test.ts bridge/__tests__/gimExtract.test.ts src/viewer/__tests__/ifcSharedImport.test.ts src/viewer/__tests__/ifcRegionalInstances.test.ts",
    "lint": "eslint src bridge",
    "check:caches": "node scripts/check-cache-contracts.mjs"
  },
  "author": "bamboosjtu",
  "license": "MIT",
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@thatopen/components": "^3.4.6",
    "@thatopen/fragments": "^3.4.0",
    "camera-controls": "^3.1.2",
    "fast-xml-parser": "5.7.2",
    "libarchive.js": "^2.0.2",
    "maplibre-gl": "^5.24.0",
    "three": "^0.184.0",
    "three-bvh-csg": "^0.0.18",
    "web-ifc": "0.0.78"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.3",
    "@types/jsdom": "^28.0.3",
    "@types/three": "^0.184.0",
    "@vitest/coverage-v8": "^2.0.0",
    "7zip-min": "^3.0.1",
    "eslint": "^9.39.5",
    "jsdom": "^25.0.0",
    "playwright-core": "1.64.1",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^5.0.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
