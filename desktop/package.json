{
  "name": "gim-reader",
  "version": "0.2.0",
  "description": "GIM 浏览器",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-web-ifc-wasm.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-web-ifc-wasm.mjs",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "pretauri:dev": "node scripts/copy-web-ifc-wasm.mjs",
    "tauri:dev": "node scripts/tauri-wrapper.mjs dev",
    "webview2:prepare": "node scripts/prepare-webview2-fixed-runtime.mjs",
    "pretauri:build": "node scripts/copy-web-ifc-wasm.mjs && node scripts/prepare-webview2-fixed-runtime.mjs",
    "tauri:build": "node scripts/tauri-wrapper.mjs build",
    "posttauri:build": "node scripts/package-portable.mjs",
    "test": "vitest run",
    "test:sqlite": "vitest run --config vitest.sqlite.config.ts",
    "test:sample": "vitest run --config vitest.sample.config.ts",
    "test:substation:strict": "node scripts/test-substation-strict.mjs",
    "test:all": "vitest run --config vitest.sample.config.ts && vitest run && npm run test:sqlite",
    "test:watch": "vitest",
    "acceptance:build": "node scripts/benchmarks/acceptance-build.mjs",
    "acceptance:stage": "node scripts/benchmarks/acceptance-stage.mjs",
    "test:acceptance-tools": "node --test scripts/benchmarks/acceptance-build.test.mjs scripts/benchmarks/acceptance-probe.test.mjs",
    "test:coverage": "vitest run --coverage",
    "test:ifc-critical": "vitest run src/viewer/__tests__/ifcConversion.test.ts src/viewer/__tests__/ifcSessionRace.test.ts src/viewer/__tests__/ifcFragmentsCache.test.ts src/viewer/__tests__/ifcNameIndex.test.ts src/viewer/__tests__/ifcOpeningPolicy.test.ts src/viewer/__tests__/ifcRegionalData.test.ts src/viewer/__tests__/ifcBimLoader.test.ts src/viewer/__tests__/webIfcCompatibility.test.ts src/ui/__tests__/ifcDetailModeControl.test.ts bridge/__tests__/gimExtract.test.ts src/viewer/__tests__/ifcSharedImport.test.ts src/viewer/__tests__/ifcRegionalInstances.test.ts"
  },
  "author": "bamboosjtu",
  "license": "MIT",
  "dependencies": {
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@thatopen/components": "^3.4.6",
    "@thatopen/fragments": "^3.4.0",
    "camera-controls": "^3.1.2",
    "fast-xml-parser": "5.7.2",
    "libarchive.js": "^2.0.2",
    "maplibre-gl": "^5.24.0",
    "three": "^0.184.0",
    "three-bvh-csg": "^0.0.18",
    "web-ifc": "0.0.78"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.3",
    "@types/jsdom": "^28.0.3",
    "@types/three": "^0.184.0",
    "@vitest/coverage-v8": "^2.0.0",
    "7zip-min": "^3.0.1",
    "jsdom": "^25.0.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
