{
  "name": "@gim/gim-sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Portable GIM source, semantic, geometry-address, binding and projection core",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "gim-source": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./source": {
      "types": "./src/source/source.ts",
      "gim-source": "./src/source/source.ts",
      "import": "./dist/source/source.js"
    },
    "./semantic": {
      "types": "./src/semantic/semantic.ts",
      "gim-source": "./src/semantic/semantic.ts",
      "import": "./dist/semantic/semantic.js"
    },
    "./geometry": {
      "types": "./src/geometry/geometry.ts",
      "gim-source": "./src/geometry/geometry.ts",
      "import": "./dist/geometry/geometry.js"
    },
    "./engineering": {
      "types": "./src/engineering/fusion.ts",
      "gim-source": "./src/engineering/fusion.ts",
      "import": "./dist/engineering/fusion.js"
    },
    "./projection": {
      "types": "./src/projection/projection.ts",
      "gim-source": "./src/projection/projection.ts",
      "import": "./dist/projection/projection.js"
    },
    "./parser": {
      "types": "./src/parser/parser.ts",
      "gim-source": "./src/parser/parser.ts",
      "import": "./dist/parser/parser.js"
    },
    "./source-adapter": {
      "types": "./src/adapters/semanticAdapter.ts",
      "gim-source": "./src/adapters/semanticAdapter.ts",
      "import": "./dist/adapters/semanticAdapter.js"
    }
  },
  "files": [
    "dist",
    "src/**/*.ts",
    "src/**/*.json",
    "!src/**/__tests__/**"
  ],
  "scripts": {
    "check": "node policy-fingerprints.mjs && tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "sync:policy": "node policy-fingerprints.mjs --write",
    "build": "npm run check && node build.mjs",
    "test": "tsc -p tsconfig.test.json && node test-unit.mjs",
    "test:consumer": "node test-consumer.mjs"
  },
  "dependencies": {
    "@gim/gim-primitives": "file:../gim-primitives",
    "earcut": "3.2.3"
  },
  "devDependencies": {
    "esbuild": "0.21.5",
    "fast-xml-parser": "5.7.2",
    "typescript": "5.9.3",
    "vitest": "2.0.0",
    "@vitest/coverage-v8": "2.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "bundledDependencies": [
    "@gim/gim-primitives"
  ]
}
