  "files": [
    "dist",
    "src/**/*.ts",
    "src/**/*.json",
    "!src/**/__tests__/**"
  ],
  "scripts": {
    "check": "node policy-fingerprints.mjs && tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "sync:policy": "node policy-fingerprints.mjs --write",
    "build": "npm run check && node build.mjs",
    "test": "tsc -p tsconfig.test.json && node test-unit.mjs",
    "test:consumer": "node test-consumer.mjs"
  },
  "dependencies": {
    "@gim/powerline-core": "file:../powerline-core"
  },
  "devDependencies": {
    "esbuild": "0.21.5",
    "typescript": "5.9.3",
    "vitest": "2.0.0",
    "@vitest/coverage-v8": "2.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "bundledDependencies": [
    "@gim/powerline-core"
  ]
}
